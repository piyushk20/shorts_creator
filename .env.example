# ====================================================================
# CreatorFlow AI Studio - Environment Configuration
# ====================================================================

# Application Settings
APP_NAME="CreatorFlow AI Studio"
APP_ENV=development
PORT=8002
HOST=127.0.0.1
DEBUG=true

# Storage Settings
STORAGE_DIR="c:/Users/HP/shortscreator/storage"

# FFmpeg Executable (Auto-detected if blank, uses imageio-ffmpeg bundled binary)
FFMPEG_PATH="C:/Python314/Lib/site-packages/imageio_ffmpeg/binaries/ffmpeg-win-x86_64-v7.1.exe"

# LLM Providers (Configure at least one or rely on intelligent rule-based fallback)
LLM_PROVIDER="fallback"   # Options: "openai", "gemini", "ollama", "fallback"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Stock Video Providers
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Text-To-Speech (TTS)
TTS_PROVIDER="edge"       # Options: "edge", "openai", "elevenlabs"
DEFAULT_VOICE_EN="en-US-ChristopherNeural"
DEFAULT_VOICE_HI="hi-IN-MadhurNeural"

# Rendering Engine
RENDERER_BACKEND="hyperframes" # Options: "hyperframes", "remotion", "ffmpeg"
MAX_CONCURRENT_RENDERS=2

# Optional Publishing / Webhooks
N8N_WEBHOOK_URL=""
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
